name: Windows build and package

on:
  push:
    branches: [main]
    tags: ['v*']
  pull_request:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  build:
    runs-on: windows-latest
    steps:
      - uses: actions/checkout@v4
      - name: Build and test
        shell: powershell
        run: ./scripts/package.ps1
      - name: Upload distributable
        uses: actions/upload-artifact@v4
        with:
          name: gpt-wait-break-win-x64
          path: |
            dist/*.zip
            dist/*.sha256
          if-no-files-found: error
  release:
    if: startsWith(github.ref, 'refs/tags/v')
    needs: build
    runs-on: windows-latest
    permissions:
      contents: write
    steps:
      - uses: actions/checkout@v4
      - uses: actions/download-artifact@v4
        with:
          name: gpt-wait-break-win-x64
          path: release-assets
      - name: Publish GitHub Release
        shell: powershell
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          $version = (Get-Content plugin.json -Raw -Encoding UTF8 | ConvertFrom-Json).version
          if ($env:GITHUB_REF_NAME -ne "v$version") { throw 'Tag does not match plugin.json version.' }
          $assets = @(Get-ChildItem -LiteralPath release-assets -File | Select-Object -ExpandProperty FullName)
          gh release create $env:GITHUB_REF_NAME @assets --verify-tag --generate-notes --prerelease --title "GPT Wait Break $version (Windows x64 preview)"
          if ($LASTEXITCODE -ne 0) { throw 'GitHub Release creation failed.' }
